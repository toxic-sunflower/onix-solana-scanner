@page "/login"
@layout Onix.Scanner.Admin.Components.Layout.EmptyLayout
@attribute [AllowAnonymous]
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<PageTitle>Onix Admin — Login</PageTitle>

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0d0e12;font-family:-apple-system,'Segoe UI',Roboto,sans-serif;">
    <div style="width:100%;max-width:320px;padding:32px;background:#16171d;border:1px solid #2a2b36;border-radius:12px;">
        <h3 style="color:#f59e0b;margin:0 0 20px;font-weight:700;">Onix Admin</h3>

        @if (HttpContextAccessor.HttpContext?.Request.Query["error"].ToString() == "1")
        {
            <p style="color:#ef4444;font-size:14px;margin-bottom:12px;">Invalid username or password.</p>
        }

        <form method="post" action="account/login" style="display:flex;flex-direction:column;gap:10px;">
            <input type="text" name="username" placeholder="Username" autocomplete="username"
                   style="padding:9px 12px;background:#1a1b24;border:1px solid #2a2b36;border-radius:6px;color:#f1f5f9;font-size:14px;box-sizing:border-box;" />
            <input type="password" name="password" placeholder="Password" autocomplete="current-password"
                   style="padding:9px 12px;background:#1a1b24;border:1px solid #2a2b36;border-radius:6px;color:#f1f5f9;font-size:14px;box-sizing:border-box;" />
            <button type="submit"
                    style="padding:9px;background:#d97706;color:#000;font-weight:600;border:none;border-radius:6px;cursor:pointer;margin-top:4px;">
                Log in
            </button>
        </form>
    </div>
</div>
